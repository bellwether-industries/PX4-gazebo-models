<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="depot_barrel_rack">
    <static>true</static>
    <!-- Single shelving cabinet: 1.2 m wide x 0.5 m deep x 2.4 m tall -->
    <link name="link">
