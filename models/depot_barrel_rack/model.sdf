      <visual name="shelf_4"><pose>0 0 2.35 0 0 0</pose><geometry><box><size>0.48 1.16 0.03</size></box></geometry><material><diffuse>0.25 0.25 0.25 1</diffuse></material></visual>
      <!-- Top shelf: red barrels -->
      <visual name="barrel_0"><pose>-0.05  0.30 2.05 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.45</length></cylinder></geometry><material><diffuse>0.75 0.08 0.08 1</diffuse><specular>0.4 0.1 0.1 1</specular></material></visual>
