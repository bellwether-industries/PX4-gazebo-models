<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='bq410_vslam'>
    <!-- Spawned by airframe 4025_gz_bq410_vslam. Same airframe and sensors as
         bq410 (D455F, MTF-01 flow + ToF, 2D lidar); only the airframe's EKF2
         control params differ. Keep sensor changes in bq410/model.sdf. -->
    <include merge='true'>
      <uri>model://bq410</uri>
    </include>

    <!-- Ground-truth odometry as external vision source for EKF2 (stands in for
         the VSLAM pipeline in simulation) -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
