<?xml version="1.0"?>
<sdf version="1.9">
  <model name="lidar_2d_generic">
    <link name="lidar_2d_generic_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.017 0 0 0</pose>
        <mass>0.045</mass>
        <inertia>
          <ixx>9.9e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>9.9e-06</iyy>
          <iyz>0</iyz>
          <izz>1.12e-05</izz>
        </inertia>
      </inertial>
      <collision name="lidar_2d_generic_collision">
        <pose>0 0 0.017 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0386 0.0386 0.0339</size>
          </box>
        </geometry>
      </collision>
      <!-- YDLidar TFmini Plus mesh (meters, Z-up). Origin at geometry center; shift up so base sits on link origin. -->
      <visual name="lidar_2d_generic_visual">
        <pose>0 0 0.01511 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://lidar_2d_generic/meshes/ydlidar-tfmini-plus.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <!-- YDLidar T-mini Plus: 360 deg, 0.05-12 m, 6-12 Hz scan (400 samples @ 10 Hz ~= 4000 Hz ranging) -->
      <sensor name="lidar_2d_generic" type="gpu_lidar">
        <gz_frame_id>lidar_2d_generic_link</gz_frame_id>
        <pose>0 0 0.028 0 0 0</pose>
        <topic>/lidar/scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>400</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>12</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.001</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
