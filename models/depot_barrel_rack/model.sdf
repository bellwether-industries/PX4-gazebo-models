      <visual name="post_fl"><pose>-0.22  0.55 1.2 0 0 0</pose><geometry><box><size>0.04 0.04 2.4</size></box></geometry><material><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="post_fr"><pose>-0.22 -0.55 1.2 0 0 0</pose><geometry><box><size>0.04 0.04 2.4</size></box></geometry><material><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
