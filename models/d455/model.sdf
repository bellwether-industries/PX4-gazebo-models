<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='d455'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="d455_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.072</mass>
        <inertia>
          <ixx>3.881e-03</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.989e-04</iyy>
          <iyz>0</iyz>
          <izz>3.879e-03</izz>
        </inertia>
      </inertial>
      <visual name="d455/visual">
        <!-- camera_link = RealSense depth origin: left IR imager optical centre,
             47.5 mm left of case centre, 4.55 mm behind the front glass (glass
             0.1 mm inside the front plate). Datasheet Rev 009 Fig. 4-4 /
             realsense2_description _d455.urdf.xacro. Mesh origin sits at this
             offset from it. -->
        <pose>-0.0097710 -0.0476608 -0.0010168 1.5707963 0 1.5707963</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://d455/meshes/d455_with_mounts.glb</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- D455F RGB: 320x240 @ 15 fps, HFOV 87 deg (matches RealSense /camera/color/*) -->
      <sensor name="d455_color" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.518</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.52</near>
            <far>6.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <optical_frame_id>camera_color_optical_frame</optical_frame_id>
          <camera_info_topic>camera/color/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>camera/color/image_raw</topic>
      </sensor>

      <!-- D455F depth aligned to color (matches RealSense /camera/aligned_depth_to_color/*) -->
      <sensor name="d455_depth" type="depth_camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.518</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.52</near>
            <far>6.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
          <optical_frame_id>camera_color_optical_frame</optical_frame_id>
          <camera_info_topic>camera/aligned_depth_to_color/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>camera/aligned_depth_to_color/image_raw</topic>
      </sensor>

      <gravity>true</gravity>
      <velocity_decay/>
    </link>
  </model>
</sdf>
