<?xml version="1.0"?>
<model>
  <name>gm3_gimbal</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name></name>
    <email></email>
  </author>
  <description>3-axis (yaw/pitch/roll) FPV gimbal + camera, modeled on the CaddxFPV Gimbal GM3 V2 (48 g, +/-0.005 deg stabilization accuracy, +/-1500 deg/s max tracking speed, PWM/UART control -- https://www.caddxfpv.com/products/caddxfpv-gimbal-gm3-v2) carrying a Walksnail Avatar HD Pro camera (1/1.8" Sony Starvis II sensor, 160 deg FOV, 1080p60, ~9.5 g -- https://www.caddxfpv.com/products/walksnail-avatar-hd-pro-kit-dual-antenna). Meshes and mounting geometry from q410-gz-body.blend (Gimbal_GM3 + FPV_Walksnail_Camera objects); joint ranges and control gains are estimates where Caddx doesn't publish figures (documented in model.sdf).</description>
</model>
