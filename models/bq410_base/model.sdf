    <!-- ======== Rotor 3 — rear-right (CW) ======== -->
    <link name="rotor_3">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>-0.153 -0.148 0.016 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>5.0e-06</ixx>
          <iyy>5.0e-06</iyy>
