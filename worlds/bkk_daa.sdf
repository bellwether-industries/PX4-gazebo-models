    <!-- Landing pad row at x = 2.0, five DICT_4X4_50 markers along y.
         0.21 m squares with 0.5 m of clear floor between edges, so centres
         are 0.71 m apart. Distinct ids so a detector can tell them apart;
         the centre tag keeps id 0. -->
    <include>
      <uri>model://arucotag</uri>
      <name>aruco_landing_2m</name>
      <pose>2.0 0 0.001 0 0 0</pose>
    </include>
    <include>
      <uri>model://arucotag_1</uri>
      <name>aruco_landing_2m_id1</name>
      <pose>2.0 -1.42 0.001 0 0 0</pose>
    </include>
    <include>
      <uri>model://arucotag_2</uri>
      <name>aruco_landing_2m_id2</name>
