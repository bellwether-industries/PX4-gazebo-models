      <visual name="post_br"><pose> 0.22 -0.55 1.2 0 0 0</pose><geometry><box><size>0.04 0.04 2.4</size></box></geometry><material><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <!-- Shelves -->
      <visual name="shelf_0"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>0.48 1.16 0.03</size></box></geometry><material><diffuse>0.25 0.25 0.25 1</diffuse></material></visual>
