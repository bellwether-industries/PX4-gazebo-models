      <visual name="barrel_3"><pose>-0.05  0.45 2.05 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.45</length></cylinder></geometry><material><diffuse>0.75 0.08 0.08 1</diffuse><specular>0.4 0.1 0.1 1</specular></material></visual>
      <visual name="barrel_4"><pose>-0.05 -0.45 2.05 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.45</length></cylinder></geometry><material><diffuse>0.75 0.08 0.08 1</diffuse><specular>0.4 0.1 0.1 1</specular></material></visual>
