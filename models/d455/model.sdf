<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='d455'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="camera_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.072</mass>
        <inertia>
          <ixx>3.881e-03</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.989e-04</iyy>
          <iyz>0</iyz>
          <izz>3.879e-03</izz>
        </inertia>
      </inertial>
      <visual name="d455/visual">
        <pose>0 0 0 1.5707963 0 1.5707963</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://d455/meshes/d455.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- D455 RGB camera: 320x240 @ 15 fps, HFOV 90 deg -->
      <sensor name="d455_color" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>d455_color</topic>
      </sensor>

      <!-- D455 stereo depth module: 320x240 @ 15 fps, HFOV 87 deg -->
      <sensor name="d455_depth" type="depth_camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.518</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>20.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>d455_depth</topic>
      </sensor>

      <gravity>true</gravity>
      <velocity_decay/>
    </link>
  </model>
</sdf>
