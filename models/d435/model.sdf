<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='d435'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="camera_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.072</mass>
        <inertia>
          <ixx>0.0000261</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000055</iyy>
          <iyz>0</iyz>
          <izz>0.0000238</izz>
        </inertia>
      </inertial>
      <visual name="d435/visual">
        <pose>0.0043 -0.0175 0 1.5708 0 1.5708</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://d435/meshes/d435.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="d435/collision">
        <pose>0 -0.0175 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02505 0.090 0.025</size>
          </box>
        </geometry>
      </collision>

      <!-- D435 RGB color camera: 320x240 @ 15 fps, HFOV 69.4° -->
      <sensor name="d435_color" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>d435_color</topic>
      </sensor>

      <!-- D435 stereo depth module: 320x240 @ 15 fps, HFOV 87° -->
      <sensor name="d435_depth" type="depth_camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.518</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.105</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>d435_depth</topic>
      </sensor>

      <gravity>true</gravity>
      <velocity_decay/>
    </link>
  </model>
</sdf>
